rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.email is string && data.email.size() <= 320
        && data.email == request.auth.token.email
        && data.language in ['en', 'fi']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && validProfile(uid)
        // RE2 counts Unicode code points; size() counts UTF-16 units in the emulator.
        && request.resource.data.displayName.matches('(?s).{3,30}')
        && request.resource.data.displayName == request.resource.data.displayName.trim()
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(uid)
        && discoveryIdentityConsistent(uid)
        && (request.resource.data.displayName == resource.data.displayName
          || (request.resource.data.displayName.matches('(?s).{3,30}')
            && request.resource.data.displayName == request.resource.data.displayName.trim()))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'language', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    function signedIn() { return request.auth != null; }
    // Search is a separate safe projection, never a list grant on private users/publicProfiles.
    function directoryShape(data,id) {
      return publicAlias(id) && data.keys().hasAll(['id','displayName','searchName','category','accent','visibility','updatedAt'])
        && data.keys().hasOnly(['id','displayName','searchName','category','accent','visibility','updatedAt'])
        && data.id == id && shortText(data.displayName,64) && data.displayName.size() > 0
        && data.searchName == data.displayName.lower().replace('Ä','ä').replace('Ö','ö').replace('Å','å') && data.visibility == 'public'
        && (data.category == null || category(data.category)) && data.accent in ['gold','ocean','forest','rose']
        && data.updatedAt is timestamp;
    }
    function profileDirectoryMatches(uid,prefs) {
      let data = getAfter(/databases/$(database)/documents/profileDirectory/$(prefs.publicId)).data;
      let profile = getAfter(/databases/$(database)/documents/publicProfiles/$(prefs.publicId)).data;
      return directoryShape(data,prefs.publicId)
        && data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
        && data.displayName == profile.displayName && data.category == prefs.category && data.accent == prefs.accent;
    }
    function directoryPrivacy(uid,prefs) {
      // Legacy public profiles without a directory remain safe and searchable on owned login/save.
      return prefs.state == 'active' && prefs.visibility == 'public'
        ? (!existsAfter(/databases/$(database)/documents/profileDirectory/$(prefs.publicId)) || profileDirectoryMatches(uid,prefs))
        : !existsAfter(/databases/$(database)/documents/profileDirectory/$(prefs.publicId));
    }
    function discoveryIdentityConsistent(uid) {
      let path = /databases/$(database)/documents/users/$(uid)/preferences/publicProfile;
      return !existsAfter(path) || directoryPrivacy(uid,getAfter(path).data);
    }
    match /profileDirectory/{id} {
      allow get: if signedIn() && resource.data.visibility == 'public'
        && resource.data.keys().hasOnly(['id','displayName','searchName','category','accent','visibility','updatedAt']);
      allow list: if signedIn() && request.query.limit != null && request.query.limit > 0 && request.query.limit <= 10
        && (request.query.offset == null || request.query.offset == 0) && resource.data.visibility == 'public'
        && resource.data.keys().hasOnly(['id','displayName','searchName','category','accent','visibility','updatedAt']);
      allow create, update: if signedIn() && directoryShape(request.resource.data,id)
        && getAfter(/databases/$(database)/documents/profileOwners/$(id)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/publicProfile).data.publicId == id
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/publicProfile).data.state == 'active'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/publicProfile).data.visibility == 'public'
        && profileDirectoryMatches(request.auth.uid,getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/publicProfile).data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && owns(profileOwner(id));
    }
    // Public aliases are presentation handles, never Firebase identities or bearer permissions.
    function publicAlias(id) { return id is string && id.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'); }
    function publicIds(ids, max) {
      return ids is list && ids.size() <= max && ids.toSet().size() == ids.size()
        && (ids.size() < 1 || publicAlias(ids[0])) && (ids.size() < 2 || publicAlias(ids[1]))
        && (ids.size() < 3 || publicAlias(ids[2])) && (ids.size() < 4 || publicAlias(ids[3]));
    }
    function publicSettings(data) {
      return data.keys().hasAll(['publicId','state','visibility','bio','category','accent','banner','featuredVehicle','vehicleIds','affiliationIds','updatedAt'])
        && data.keys().hasOnly(['publicId','state','visibility','bio','category','accent','banner','featuredVehicle','vehicleIds','affiliationIds','updatedAt'])
        && publicAlias(data.publicId) && data.state in ['active','retired'] && data.visibility in ['private','public']
        && shortText(data.bio,300) && (data.category == null || category(data.category))
        && data.accent in ['gold','ocean','forest','rose'] && data.banner in ['road','horizon','grid']
        && publicIds(data.vehicleIds,4) && publicIds(data.affiliationIds,2)
        && (data.featuredVehicle == null || data.featuredVehicle in data.vehicleIds)
        && data.updatedAt == request.time;
    }
    function publicProfileShape(data, id) {
      return data.keys().hasAll(['id','displayName','bio','category','accent','banner','featuredVehicle','vehicleIds','affiliationIds','updatedAt'])
        && data.keys().hasOnly(['id','displayName','bio','category','accent','banner','featuredVehicle','vehicleIds','affiliationIds','updatedAt'])
        && data.id == id && publicAlias(id) && shortText(data.displayName,64) && data.displayName.size() > 0
        && shortText(data.bio,300) && (data.category == null || category(data.category))
        && data.accent in ['gold','ocean','forest','rose'] && data.banner in ['road','horizon','grid']
        && publicIds(data.vehicleIds,4) && publicIds(data.affiliationIds,2)
        && (data.featuredVehicle == null || data.featuredVehicle in data.vehicleIds) && data.updatedAt is timestamp;
    }
    function publicProjection(data, uid, id) {
      let prefs = getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data;
      return publicProfileShape(data,id) && prefs.publicId == id && prefs.state == 'active'
        && data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
        && data.bio == prefs.bio && data.category == prefs.category && data.accent == prefs.accent && data.banner == prefs.banner
        && data.featuredVehicle == prefs.featuredVehicle && data.vehicleIds == prefs.vehicleIds && data.affiliationIds == prefs.affiliationIds
        && data.updatedAt == request.time;
    }
    function profileOwner(id) { return get(/databases/$(database)/documents/profileOwners/$(id)).data.ownerUid; }
    function publicProfileAvailable(id) {
      let uid = profileOwner(id);
      let prefs = get(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data;
      return publicAlias(id) && prefs.publicId == id && prefs.state == 'active' && prefs.visibility == 'public';
    }
    match /profileOwners/{id} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/profileOwners/$(id)) || owns(resource.data.ownerUid));
      allow list, update, delete: if false;
      allow create: if signedIn() && publicAlias(id)
        && request.resource.data.keys().hasAll(['ownerUid','createdAt']) && request.resource.data.keys().hasOnly(['ownerUid','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/publicProfile).data.publicId == id;
    }
    match /users/{uid}/preferences/publicProfile {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create: if owns(uid) && publicSettings(request.resource.data) && request.resource.data.state == 'active'
        && directoryPrivacy(uid,request.resource.data)
        && getAfter(/databases/$(database)/documents/profileOwners/$(request.resource.data.publicId)).data.ownerUid == uid
        && publicProjection(getAfter(/databases/$(database)/documents/publicProfiles/$(request.resource.data.publicId)).data,uid,request.resource.data.publicId);
      allow update: if owns(uid) && publicSettings(request.resource.data) && resource.data.state == 'active'
        && directoryPrivacy(uid,request.resource.data)
        && request.resource.data.publicId == resource.data.publicId
        && (request.resource.data.state == 'retired' && request.resource.data.visibility == 'private'
          || request.resource.data.state == 'active'
            && publicProjection(getAfter(/databases/$(database)/documents/publicProfiles/$(resource.data.publicId)).data,uid,resource.data.publicId));
    }
    match /publicProfiles/{id} {
      allow get: if publicProfileShape(resource.data,id) && (publicProfileAvailable(id) || owns(profileOwner(id)));
      allow list, delete: if false;
      allow create, update: if signedIn()
        && getAfter(/databases/$(database)/documents/profileOwners/$(id)).data.ownerUid == request.auth.uid
        && publicProjection(request.resource.data,request.auth.uid,id);
    }
    // Display names are discoverable within the signed-in app; private profiles stay private.
    function affiliationShape(data,id) {
      return publicAlias(id) && data.keys().hasAll(['id','clubId','name','rank','updatedAt'])
        && data.keys().hasOnly(['id','clubId','name','rank','updatedAt']) && data.id == id
        && identifier(data.clubId) && shortText(data.name,80) && (data.rank == null || shortText(data.rank,64)) && data.updatedAt is timestamp;
    }
    function affiliationRank(data,member,clubId) {
      return member.rankId == null && data.rank == null
        || member.rankId != null && (!exists(/databases/$(database)/documents/clubs/$(clubId)/ranks/$(member.rankId)) && data.rank == null
          || get(/databases/$(database)/documents/clubs/$(clubId)/ranks/$(member.rankId)).data.name == data.rank);
    }
    function affiliationAvailable(profile,id,data) {
      let uid = profileOwner(profile);
      let mapping = get(/databases/$(database)/documents/profileOwners/$(profile)/affiliations/$(id)).data;
      let club = get(/databases/$(database)/documents/clubs/$(mapping.clubId)).data;
      let member = get(/databases/$(database)/documents/clubs/$(mapping.clubId)/members/$(uid)).data;
      return publicProfileAvailable(profile) && id in get(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data.affiliationIds
        && mapping.clubId == data.clubId && club.visibility == 'public' && club.state in ['active','archived']
        && club.name == data.name && member.joinedAt == mapping.joinedAt && affiliationRank(data,member,data.clubId);
    }
    function affiliationWrite(profile,id,data) {
      let uid = request.auth.uid;
      let mapping = getAfter(/databases/$(database)/documents/profileOwners/$(profile)/affiliations/$(id)).data;
      let club = get(/databases/$(database)/documents/clubs/$(mapping.clubId)).data;
      let member = get(/databases/$(database)/documents/clubs/$(mapping.clubId)/members/$(uid)).data;
      let prefs = getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data;
      return owns(profileOwner(profile)) && prefs.publicId == profile && prefs.state == 'active' && id in prefs.affiliationIds
        && affiliationShape(data,id) && mapping.clubId == data.clubId && club.visibility == 'public' && club.state in ['active','archived']
        && club.name == data.name && member.joinedAt == mapping.joinedAt && affiliationRank(data,member,data.clubId) && data.updatedAt == request.time;
    }
    match /profileOwners/{profile}/affiliations/{id} {
      allow get: if owns(profileOwner(profile));
      allow list, update: if false;
      allow create: if owns(profileOwner(profile)) && publicAlias(id)
        && request.resource.data.keys().hasAll(['clubId','joinedAt','createdAt']) && request.resource.data.keys().hasOnly(['clubId','joinedAt','createdAt'])
        && identifier(request.resource.data.clubId) && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)).data.visibility == 'public'
        && get(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)/members/$(request.auth.uid)).data.joinedAt == request.resource.data.joinedAt;
      allow delete: if owns(profileOwner(profile));
    }
    match /publicProfiles/{profile}/affiliations/{id} {
      allow get: if owns(profileOwner(profile)) && (!exists(/databases/$(database)/documents/publicProfiles/$(profile)/affiliations/$(id)) || affiliationShape(resource.data,id))
        || affiliationShape(resource.data,id) && affiliationAvailable(profile,id,resource.data);
      allow list: if false;
      allow create, update: if signedIn() && affiliationWrite(profile,id,request.resource.data);
      allow delete: if owns(profileOwner(profile));
    }
    function showcaseShape(data, id) {
      return data.keys().hasAll(['id','nickname','manufacturer','model','modelYear','category','publicDescription','createdAt','updatedAt'])
        && data.keys().hasOnly(['id','nickname','manufacturer','model','modelYear','category','publicDescription','createdAt','updatedAt'])
        && publicAlias(id) && data.id == id && shortText(data.nickname,64) && data.nickname.size() > 0
        && shortText(data.manufacturer,64) && shortText(data.model,64) && category(data.category)
        && (data.modelYear == null || data.modelYear is int && data.modelYear >= 1885 && data.modelYear <= request.time.year() + 1)
        && shortText(data.publicDescription,500) && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function showcaseAvailable(profile, id) {
      let uid = profileOwner(profile);
      let mapping = get(/databases/$(database)/documents/profileOwners/$(profile)/vehicles/$(id)).data;
      let source = get(/databases/$(database)/documents/users/$(uid)/vehicles/$(mapping.sourceVehicleId)).data;
      let explicit = get(/databases/$(database)/documents/users/$(uid)/showcaseRefs/$(mapping.sourceVehicleId)).data;
      return publicProfileAvailable(profile) && source.visibility == 'public' && source.createdAt == mapping.sourceCreatedAt
        && explicit.profileId == profile && explicit.publicId == id
        && id in get(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data.vehicleIds;
    }
    function showcaseWrite(profile, id, data) {
      let uid = request.auth.uid;
      let mapping = getAfter(/databases/$(database)/documents/profileOwners/$(profile)/vehicles/$(id)).data;
      let source = getAfter(/databases/$(database)/documents/users/$(uid)/vehicles/$(mapping.sourceVehicleId)).data;
      let explicit = getAfter(/databases/$(database)/documents/users/$(uid)/showcaseRefs/$(mapping.sourceVehicleId)).data;
      let prefs = getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data;
      return getAfter(/databases/$(database)/documents/profileOwners/$(profile)).data.ownerUid == uid
        && prefs.publicId == profile && prefs.state == 'active' && id in prefs.vehicleIds
        && explicit.profileId == profile && explicit.publicId == id && source.visibility == 'public' && source.createdAt == mapping.sourceCreatedAt
        && data.nickname == source.nickname && data.manufacturer == source.manufacturer && data.model == source.model
        && data.modelYear == source.modelYear && data.category == source.category
        && showcaseShape(data,id) && data.updatedAt == request.time;
    }
    match /profileOwners/{profile}/vehicles/{id} {
      allow get: if owns(profileOwner(profile));
      allow list: if false;
      allow create: if owns(profileOwner(profile)) && publicAlias(id)
        && request.resource.data.keys().hasAll(['sourceVehicleId','sourceCreatedAt','createdAt']) && request.resource.data.keys().hasOnly(['sourceVehicleId','sourceCreatedAt','createdAt'])
        && identifier(request.resource.data.sourceVehicleId) && request.resource.data.createdAt == request.time
        && request.resource.data.sourceCreatedAt == getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.sourceVehicleId)).data.createdAt
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/showcaseRefs/$(request.resource.data.sourceVehicleId)).data.publicId == id
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/showcaseRefs/$(request.resource.data.sourceVehicleId)).data.profileId == profile;
      allow update: if false;
      allow delete: if owns(profileOwner(profile));
    }
    match /users/{uid}/showcaseRefs/{vehicleId} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && identifier(vehicleId)
        && request.resource.data.keys().hasAll(['profileId','publicId','createdAt']) && request.resource.data.keys().hasOnly(['profileId','publicId','createdAt'])
        && publicAlias(request.resource.data.profileId) && publicAlias(request.resource.data.publicId) && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/profileOwners/$(request.resource.data.profileId)).data.ownerUid == uid
        && getAfter(/databases/$(database)/documents/profileOwners/$(request.resource.data.profileId)/vehicles/$(request.resource.data.publicId)).data.sourceVehicleId == vehicleId
        && getAfter(/databases/$(database)/documents/users/$(uid)/vehicles/$(vehicleId)).data.visibility == 'public';
      allow update: if false;
      allow delete: if owns(uid);
    }
    match /publicProfiles/{profile}/vehicles/{id} {
      allow get: if (owns(profileOwner(profile)) && (!exists(/databases/$(database)/documents/publicProfiles/$(profile)/vehicles/$(id)) || showcaseShape(resource.data,id)))
        || (showcaseShape(resource.data,id) && showcaseAvailable(profile,id));
      allow list: if false;
      allow create: if signedIn() && showcaseWrite(profile,id,request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && showcaseWrite(profile,id,request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(profileOwner(profile));
    }
    match /displayProfiles/{uid} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/displayProfiles/$(uid))
        || resource.data.keys().hasOnly(['displayName', 'updatedAt','publicProfileId']));
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 30
        && resource.data.keys().hasOnly(['displayName', 'updatedAt','publicProfileId']);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt','publicProfileId'])
        && (!('publicProfileId' in request.resource.data) || request.resource.data.publicProfileId == null
          || (publicAlias(request.resource.data.publicProfileId)
            && getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data.publicId == request.resource.data.publicProfileId
            && getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data.visibility == 'public'
            && getAfter(/databases/$(database)/documents/users/$(uid)/preferences/publicProfile).data.state == 'active'
            && getAfter(/databases/$(database)/documents/profileOwners/$(request.resource.data.publicProfileId)).data.ownerUid == uid))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 64
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function identifier(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function category(value) {
      return value in ['motorcycle', 'car', 'moped', 'scooter', 'atv-utv', 'off-road', 'snowmobile', 'caravan', 'bicycle', 'e-bike', 'e-scooter', 'other'];
    }
    function activityCategory(value) { return value == 'open' || category(value); }
    function theme(value) { return value in ['normal', 'monochrome', 'forest', 'urban', 'night']; }
    function shortText(value, max) { return value is string && value.size() <= max; }
    function color(value) { return value is string && value.matches('^#[a-fA-F0-9]{6}$'); }
    function httpsLink(value) { return value == null || (shortText(value, 500) && value.matches('^https://[^\\s]+$')); }
    function links(value) {
      return value is map && value.keys().hasAll(['website', 'whatsapp', 'discord', 'instagram', 'facebook'])
        && value.keys().hasOnly(['website', 'whatsapp', 'discord', 'instagram', 'facebook'])
        && httpsLink(value.website) && httpsLink(value.whatsapp) && httpsLink(value.discord)
        && httpsLink(value.instagram) && httpsLink(value.facebook);
    }
    function vehicle(data, uid, id) {
      return data.keys().hasAll(['id', 'ownerUid', 'category', 'nickname', 'manufacturer', 'model', 'modelYear', 'description', 'visibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'category', 'nickname', 'manufacturer', 'model', 'modelYear', 'description', 'visibility', 'createdAt', 'updatedAt'])
        && identifier(id) && data.id == id && data.ownerUid == uid && category(data.category)
        && shortText(data.nickname, 64) && data.nickname.size() > 0
        && shortText(data.manufacturer, 64) && shortText(data.model, 64) && shortText(data.description, 1000)
        && (data.modelYear == null || (data.modelYear is int && data.modelYear >= 1885 && data.modelYear <= 2100))
        && data.visibility in ['private', 'club', 'public'] && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function notificationShape(data) {
      return data.keys().hasAll(['type', 'sourceId', 'actorUid', 'createdAt', 'readAt'])
        && data.keys().hasOnly(['type', 'sourceId', 'actorUid', 'createdAt', 'readAt'])
        && identifier(data.sourceId) && data.actorUid == request.auth.uid
        && data.createdAt == request.time && data.readAt == null;
    }
    function notificationSource(uid, key, data) {
      let id = data.sourceId;
      return (data.type == 'group-invite' && groupManager(id) && groupUsable(get(groupPath(id)).data)
          && key == 'gi-' + getAfter(groupInvite(id, uid)).data.token
          && getAfter(groupInvite(id, uid)).data.uid == uid
          && getAfter(groupInvite(id, uid)).data.invitedBy == request.auth.uid
          && getAfter(groupInvite(id, uid)).data.createdAt == request.time)
        || (data.type == 'group-approved' && key == 'ga-' + id && groupManager(id)
          && get(groupRequest(id, uid)).data.state == 'pending'
          && getAfter(groupRequest(id, uid)).data.state == 'approved'
          && getAfter(groupRequest(id, uid)).data.decidedBy == request.auth.uid
          && getAfter(groupRequest(id, uid)).data.decidedAt == request.time)
        || (data.type == 'club-approved' && key == 'ca-' + id && manager(id)
          && get(/databases/$(database)/documents/clubs/$(id)/joinRequests/$(uid)).data.state == 'pending'
          && getAfter(/databases/$(database)/documents/clubs/$(id)/joinRequests/$(uid)).data.state == 'approved'
          && getAfter(/databases/$(database)/documents/clubs/$(id)/joinRequests/$(uid)).data.decidedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/clubs/$(id)/joinRequests/$(uid)).data.decidedAt == request.time
          && existsAfter(memberPath(id, uid)));
    }
    match /users/{uid}/notifications/{key} {
      allow read: if owns(uid);
      // Content is a typed source reference, never arbitrary client text or an asserted sender.
      allow create: if signedIn() && notificationShape(request.resource.data)
        && notificationSource(uid, key, request.resource.data);
      allow update: if (owns(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time)
        || (signedIn() && notificationShape(request.resource.data)
          && notificationSource(uid, key, request.resource.data));
      allow delete: if owns(uid);
    }
    match /users/{uid}/vehicles/{id} {
      allow read: if owns(uid);
      allow create: if owns(uid) && vehicle(request.resource.data, uid, id) && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && vehicle(request.resource.data, uid, id)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(uid) && (!existsAfter(/databases/$(database)/documents/users/$(uid)/preferences/garage)
        || getAfter(/databases/$(database)/documents/users/$(uid)/preferences/garage).data.defaultVehicleId != id);
    }
    match /users/{uid}/preferences/garage {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['defaultVehicleId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['defaultVehicleId', 'updatedAt'])
