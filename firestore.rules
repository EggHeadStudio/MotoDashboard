rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.email is string && data.email.size() <= 320
        && data.email == request.auth.token.email
        && data.language in ['en', 'fi']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && validProfile(uid)
        // RE2 counts Unicode code points; size() counts UTF-16 units in the emulator.
        && request.resource.data.displayName.matches('(?s).{3,30}')
        && request.resource.data.displayName == request.resource.data.displayName.trim()
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(uid)
        && (request.resource.data.displayName == resource.data.displayName
          || (request.resource.data.displayName.matches('(?s).{3,30}')
            && request.resource.data.displayName == request.resource.data.displayName.trim()))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'language', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    function signedIn() { return request.auth != null; }
    // Display names are discoverable within the signed-in app; private profiles stay private.
    match /displayProfiles/{uid} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/displayProfiles/$(uid))
        || resource.data.keys().hasOnly(['displayName', 'updatedAt']));
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 30
        && resource.data.keys().hasOnly(['displayName', 'updatedAt']);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 64
        && request.resource.data.displayName == getAfter(/databases/$(database)/documents/users/$(uid)).data.displayName
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function identifier(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function category(value) {
      return value in ['motorcycle', 'car', 'moped', 'scooter', 'atv-utv', 'off-road', 'snowmobile', 'caravan', 'bicycle', 'e-bike', 'e-scooter', 'other'];
    }
    function theme(value) { return value in ['normal', 'monochrome', 'forest', 'urban', 'night']; }
    function shortText(value, max) { return value is string && value.size() <= max; }
    function color(value) { return value is string && value.matches('^#[a-fA-F0-9]{6}$'); }
    function httpsLink(value) { return value == null || (shortText(value, 500) && value.matches('^https://[^\\s]+$')); }
    function links(value) {
      return value is map && value.keys().hasAll(['website', 'whatsapp', 'discord', 'instagram', 'facebook'])
        && value.keys().hasOnly(['website', 'whatsapp', 'discord', 'instagram', 'facebook'])
        && httpsLink(value.website) && httpsLink(value.whatsapp) && httpsLink(value.discord)
        && httpsLink(value.instagram) && httpsLink(value.facebook);
    }
    function vehicle(data, uid, id) {
      return data.keys().hasAll(['id', 'ownerUid', 'category', 'nickname', 'manufacturer', 'model', 'modelYear', 'description', 'visibility', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerUid', 'category', 'nickname', 'manufacturer', 'model', 'modelYear', 'description', 'visibility', 'createdAt', 'updatedAt'])
        && identifier(id) && data.id == id && data.ownerUid == uid && category(data.category)
        && shortText(data.nickname, 64) && data.nickname.size() > 0
        && shortText(data.manufacturer, 64) && shortText(data.model, 64) && shortText(data.description, 1000)
        && (data.modelYear == null || (data.modelYear is int && data.modelYear >= 1885 && data.modelYear <= 2100))
        && data.visibility in ['private', 'club', 'public'] && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/vehicles/{id} {
      allow read: if owns(uid);
      allow create: if owns(uid) && vehicle(request.resource.data, uid, id) && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && vehicle(request.resource.data, uid, id)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owns(uid) && (!existsAfter(/databases/$(database)/documents/users/$(uid)/preferences/garage)
        || getAfter(/databases/$(database)/documents/users/$(uid)/preferences/garage).data.defaultVehicleId != id);
    }
    match /users/{uid}/preferences/garage {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasAll(['defaultVehicleId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['defaultVehicleId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.defaultVehicleId == null
          || (identifier(request.resource.data.defaultVehicleId)
            && existsAfter(/databases/$(database)/documents/users/$(uid)/vehicles/$(request.resource.data.defaultVehicleId))));
      allow delete: if owns(uid);
    }
    function snapshot(data) {
      return data == null || (data is map && data.keys().hasAll(['nickname', 'manufacturer', 'model', 'category'])
        && data.keys().hasOnly(['nickname', 'manufacturer', 'model', 'category'])
        && shortText(data.nickname, 64) && shortText(data.manufacturer, 64) && shortText(data.model, 64) && category(data.category));
    }
    function deletedRide(uid, id) { return exists(/databases/$(database)/documents/users/$(uid)/sessionTombstones/$(id)); }
    function ride(data, uid, id) {
      return data.keys().hasAll(['id', 'schemaVersion', 'ownerUid', 'vehicleId', 'vehicleSnapshot', 'category', 'name', 'status', 'visibility', 'startedAt', 'endedAt', 'distanceMeters', 'movingDurationMs', 'averageMovingSpeedKmh', 'maxSpeedKmh', 'mapTheme', 'pointCount', 'chunkCount', 'routeHash', 'revisionId', 'baseRevisionId', 'uploadState', 'clientUpdatedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'schemaVersion', 'ownerUid', 'vehicleId', 'vehicleSnapshot', 'category', 'name', 'status', 'visibility', 'startedAt', 'endedAt', 'distanceMeters', 'movingDurationMs', 'averageMovingSpeedKmh', 'maxSpeedKmh', 'mapTheme', 'pointCount', 'chunkCount', 'routeHash', 'revisionId', 'baseRevisionId', 'uploadState', 'clientUpdatedAt', 'createdAt', 'updatedAt'])
        && identifier(id) && data.id == id && data.schemaVersion == 1 && data.ownerUid == uid
        && (data.vehicleId == null || identifier(data.vehicleId)) && snapshot(data.vehicleSnapshot)
        && (data.category == null || category(data.category)) && (data.name == null || shortText(data.name, 64))
        && data.status == 'completed' && data.visibility == 'private'
        && data.startedAt is number && data.startedAt > 0 && data.endedAt is number && data.endedAt >= data.startedAt
        && data.distanceMeters is number && data.distanceMeters >= 0 && data.movingDurationMs is number && data.movingDurationMs >= 0
        && data.averageMovingSpeedKmh is number && data.averageMovingSpeedKmh >= 0 && data.maxSpeedKmh is number && data.maxSpeedKmh >= 0
        && theme(data.mapTheme) && data.pointCount is int && data.pointCount >= 0
        && data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 10000
        && data.routeHash is string && data.routeHash.matches('^[a-f0-9]{64}$')
        && data.revisionId is string && data.revisionId.matches('^[a-f0-9]{64}$')
        && (data.baseRevisionId == null || (data.baseRevisionId is string && data.baseRevisionId.matches('^[a-f0-9]{64}$')))
        && data.uploadState in ['uploading', 'ready'] && data.clientUpdatedAt is number
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/sessions/{id} {
      allow read: if owns(uid);
      allow create: if owns(uid) && !deletedRide(uid, id) && ride(request.resource.data, uid, id)
        && request.resource.data.createdAt == request.time && request.resource.data.uploadState == 'uploading';
      allow update: if owns(uid) && !deletedRide(uid, id) && ride(request.resource.data, uid, id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'revisionId', 'baseRevisionId', 'clientUpdatedAt', 'updatedAt', 'uploadState'])
        && (request.resource.data.revisionId == resource.data.revisionId || request.resource.data.baseRevisionId == resource.data.revisionId)
        && (resource.data.uploadState == 'uploading' || request.resource.data.uploadState == 'ready');
      allow delete: if owns(uid) && existsAfter(/databases/$(database)/documents/users/$(uid)/sessionTombstones/$(id));
      match /routeChunks/{chunk} {
        allow read: if owns(uid);
        allow create: if owns(uid) && !deletedRide(uid, id)
          && getAfter(/databases/$(database)/documents/users/$(uid)/sessions/$(id)).data.uploadState == 'uploading'
          && request.resource.data.keys().hasAll(['schemaVersion', 'ownerUid', 'sessionId', 'sequence', 'pointCount', 'pointsJson', 'routeHash'])
          && request.resource.data.keys().hasOnly(['schemaVersion', 'ownerUid', 'sessionId', 'sequence', 'pointCount', 'pointsJson', 'routeHash'])
          && request.resource.data.schemaVersion == 1 && request.resource.data.ownerUid == uid && request.resource.data.sessionId == id
          && request.resource.data.sequence is int && request.resource.data.sequence >= 0 && request.resource.data.sequence < 10000
          && request.resource.data.pointCount is int && request.resource.data.pointCount > 0 && request.resource.data.pointCount <= 128
          && shortText(request.resource.data.pointsJson, 48000)
          && request.resource.data.routeHash == getAfter(/databases/$(database)/documents/users/$(uid)/sessions/$(id)).data.routeHash;
        allow update: if false;
        allow delete: if owns(uid) && deletedRide(uid, id);
      }
    }
    match /users/{uid}/sessionTombstones/{id} {
      allow read: if owns(uid);
      allow create: if owns(uid) && identifier(id)
        && request.resource.data.keys().hasAll(['id', 'ownerUid', 'deletedAt'])
        && request.resource.data.keys().hasOnly(['id', 'ownerUid', 'deletedAt'])
        && request.resource.data.id == id && request.resource.data.ownerUid == uid && request.resource.data.deletedAt == request.time;
      allow update, delete: if false;
    }
    function clubPath(id) { return /databases/$(database)/documents/clubs/$(id); }
    function memberPath(id, uid) { return /databases/$(database)/documents/clubs/$(id)/members/$(uid); }
    function availableClub(id) {
      return signedIn() && exists(clubPath(id)) && get(clubPath(id)).data.state in ['active', 'archived'];
    }
    function clubOwner(id) { return availableClub(id) && get(clubPath(id)).data.ownerUid == request.auth.uid; }
    function member(id) { return availableClub(id) && exists(memberPath(id, request.auth.uid)); }
    function clubAdmin(id) { return member(id) && get(memberPath(id, request.auth.uid)).data.technicalRole == 'admin'; }
    function manager(id) { return clubOwner(id) || clubAdmin(id); }
    function invitation(id, uid) { return /databases/$(database)/documents/clubs/$(id)/invites/$(uid); }
    function invited(id) { return availableClub(id) && get(clubPath(id)).data.state == 'active'
      && exists(invitation(id, request.auth.uid)) && get(invitation(id, request.auth.uid)).data.expiresAt > request.time; }
    // Exact public fields. Canonical authorization and membership UIDs never leave /clubs.
    function publicPage(data) {
      return {'id': data.id, 'name': data.name, 'description': data.description, 'category': data.category,
        'visibility': data.visibility, 'membershipPolicy': data.membershipPolicy,
        'primaryColor': data.primaryColor, 'accentColor': data.accentColor, 'routeColor': data.routeColor,
        'mapTheme': data.mapTheme, 'links': data.links, 'state': data.state,
        'memberCount': data.memberCount, 'updatedAt': data.updatedAt};
    }
    function pageConsistent(id, data) {
      return (data.state == 'deleted' && !existsAfter(/databases/$(database)/documents/clubPages/$(id)))
        || (data.state != 'deleted' && getAfter(/databases/$(database)/documents/clubPages/$(id)).data == publicPage(data));
    }
    function retirement(id) {
      return clubOwner(id) && resource.data.state == 'archived' && resource.data.memberCount == 1
        && request.resource.data.state == 'deleted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
        && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/clubRefs/$(id));
    }
    function validClub(data, id) {
      return data.keys().hasAll(['schemaVersion', 'id', 'ownerUid', 'name', 'description', 'category', 'visibility', 'membershipPolicy', 'primaryColor', 'accentColor', 'routeColor', 'mapTheme', 'links', 'state', 'memberCount', 'lastMembershipUid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'id', 'ownerUid', 'name', 'description', 'category', 'visibility', 'membershipPolicy', 'primaryColor', 'accentColor', 'routeColor', 'mapTheme', 'links', 'state', 'memberCount', 'lastMembershipUid', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 1 && identifier(id) && data.id == id && data.ownerUid is string
        && shortText(data.name, 80) && data.name.size() > 0 && shortText(data.description, 2000) && category(data.category)
        && data.visibility in ['public', 'unlisted', 'private'] && data.membershipPolicy in ['open', 'approval', 'invite', 'private']
        && (data.membershipPolicy != 'private' || data.visibility == 'private')
        && (data.visibility != 'private' || data.membershipPolicy in ['invite', 'private'])
        && color(data.primaryColor) && color(data.accentColor) && (data.routeColor == null || color(data.routeColor))
        && theme(data.mapTheme) && links(data.links) && data.state in ['active', 'archived', 'deleted']
        && data.memberCount is int && data.memberCount >= 1 && data.memberCount <= 100000
        && data.lastMembershipUid is string && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    function directoryConsistent(id, data) {
      return (data.visibility == 'public' && data.state == 'active'
        && existsAfter(/databases/$(database)/documents/clubDirectory/$(id))
        && directoryMatches(getAfter(/databases/$(database)/documents/clubDirectory/$(id)).data, id, data))
        || ((data.visibility != 'public' || data.state != 'active')
          && !existsAfter(/databases/$(database)/documents/clubDirectory/$(id)));
    }
    function directoryMatches(projection, id, data) {
      return projection.id == id && projection.name == data.name && projection.category == data.category
        && projection.membershipPolicy == data.membershipPolicy && projection.primaryColor == data.primaryColor
        && projection.accentColor == data.accentColor;
    }
    function countChange(id) {
      let uid = request.resource.data.lastMembershipUid;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'lastMembershipUid', 'updatedAt'])
        && ((request.resource.data.memberCount == resource.data.memberCount + 1
          && !exists(memberPath(id, uid)) && existsAfter(memberPath(id, uid)))
          || (request.resource.data.memberCount == resource.data.memberCount - 1
            && uid != resource.data.ownerUid && exists(memberPath(id, uid)) && !existsAfter(memberPath(id, uid))))
        && (request.auth.uid == uid || manager(id));
    }
    match /clubs/{id} {
      allow get: if member(id) || clubOwner(id);
      allow list: if false;
      allow create: if signedIn() && validClub(request.resource.data, id) && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.state == 'active'
        && request.resource.data.memberCount == 1 && request.resource.data.lastMembershipUid == request.auth.uid
        && getAfter(memberPath(id, request.auth.uid)).data.technicalRole == 'owner'
        && directoryConsistent(id, request.resource.data) && pageConsistent(id, request.resource.data);
      allow update: if availableClub(id) && validClub(request.resource.data, id)
        && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt
        && directoryConsistent(id, request.resource.data) && pageConsistent(id, request.resource.data)
        && (retirement(id) || (request.resource.data.state != 'deleted' && (countChange(id) || (clubOwner(id) && request.resource.data.memberCount == resource.data.memberCount
          && request.resource.data.lastMembershipUid == resource.data.lastMembershipUid)
          || (clubAdmin(id) && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['description', 'primaryColor', 'accentColor', 'routeColor', 'mapTheme', 'links', 'updatedAt'])))));
      // Retained canonical document reserves this identity forever.
      allow delete: if false;
      match /members/{uid} {
        function shape() {
          let data = request.resource.data;
          return data.keys().hasAll(['uid', 'technicalRole', 'rankId', 'joinedAt', 'updatedAt'])
            && data.keys().hasOnly(['uid', 'technicalRole', 'rankId', 'joinedAt', 'updatedAt'])
            && data.uid == uid && data.technicalRole in ['owner', 'admin', 'host', 'member']
            && (data.rankId == null || (identifier(data.rankId) && existsAfter(/databases/$(database)/documents/clubs/$(id)/ranks/$(data.rankId))))
            && data.joinedAt is timestamp && data.updatedAt == request.time;
        }
        function indexExists() { return existsAfter(/databases/$(database)/documents/users/$(uid)/clubRefs/$(id)); }
        function ordinaryAdmission() {
          let club = get(clubPath(id)).data;
          return club.state == 'active' && request.resource.data.technicalRole == 'member' && request.resource.data.rankId == null
            && (manager(id) || (request.auth.uid == uid && (club.membershipPolicy == 'open'
              || (exists(invitation(id, uid)) && get(invitation(id, uid)).data.expiresAt > request.time && !existsAfter(invitation(id, uid))))));
        }
        allow read: if availableClub(id) && (owns(uid) || member(id) || clubOwner(id));
        allow create: if signedIn() && shape() && indexExists() && request.resource.data.joinedAt == request.time
          && ((!exists(clubPath(id)) && getAfter(clubPath(id)).data.ownerUid == request.auth.uid && uid == request.auth.uid && request.resource.data.technicalRole == 'owner' && request.resource.data.rankId == null)
            || (ordinaryAdmission() && getAfter(clubPath(id)).data.memberCount == get(clubPath(id)).data.memberCount + 1
              && getAfter(clubPath(id)).data.lastMembershipUid == uid));
        allow update: if signedIn() && shape() && request.resource.data.joinedAt == resource.data.joinedAt
          && ((clubOwner(id) && ((uid == request.auth.uid && request.resource.data.technicalRole == 'owner')
            || (uid != get(clubPath(id)).data.ownerUid && request.resource.data.technicalRole != 'owner')))
            || (clubAdmin(id) && ((uid != request.auth.uid && resource.data.technicalRole in ['host', 'member'] && request.resource.data.technicalRole in ['host', 'member'])
              || (uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rankId', 'updatedAt'])))));
        allow delete: if availableClub(id) && !existsAfter(/databases/$(database)/documents/users/$(uid)/clubRefs/$(id))
          && (uid != get(clubPath(id)).data.ownerUid && (request.auth.uid == uid || clubOwner(id)
              || (clubAdmin(id) && resource.data.technicalRole in ['host', 'member']))
              && getAfter(clubPath(id)).data.memberCount == get(clubPath(id)).data.memberCount - 1
              && getAfter(clubPath(id)).data.lastMembershipUid == uid);
      }
      match /joinRequests/{uid} {
        function shape() {
          let data = request.resource.data;
          return data.keys().hasAll(['uid', 'state', 'requestedAt', 'decidedAt', 'decidedBy'])
            && data.keys().hasOnly(['uid', 'state', 'requestedAt', 'decidedAt', 'decidedBy']) && data.uid == uid;
        }
        allow read: if availableClub(id) && (request.auth.uid == uid || manager(id));
        allow create: if owns(uid) && shape() && get(clubPath(id)).data.membershipPolicy == 'approval'
          && get(clubPath(id)).data.state == 'active' && !exists(memberPath(id, uid))
          && request.resource.data.state == 'pending' && request.resource.data.requestedAt == request.time
          && request.resource.data.decidedAt == null && request.resource.data.decidedBy == null;
        allow update: if manager(id) && shape() && resource.data.state == 'pending'
          && request.resource.data.requestedAt == resource.data.requestedAt
          && request.resource.data.state in ['approved', 'rejected'] && request.resource.data.decidedAt == request.time
          && request.resource.data.decidedBy == request.auth.uid
          && (request.resource.data.state == 'rejected' || existsAfter(memberPath(id, uid)));
        allow delete: if availableClub(id) && (manager(id) || (request.auth.uid == uid && resource.data.state != 'approved'));
      }
      match /invites/{uid} {
        allow get: if availableClub(id) && (request.auth.uid == uid || manager(id));
        allow list: if manager(id);
        allow create, update: if manager(id) && get(clubPath(id)).data.state == 'active'
          && request.resource.data.keys().hasAll(['uid', 'invitedBy', 'expiresAt', 'createdAt'])
          && request.resource.data.keys().hasOnly(['uid', 'invitedBy', 'expiresAt', 'createdAt'])
          && request.resource.data.uid == uid && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
          && request.resource.data.createdAt == request.time;
        allow delete: if availableClub(id) && (manager(id) || (request.auth.uid == uid && existsAfter(memberPath(id, uid))));
      }
      match /ranks/{rank} {
        allow read: if member(id) || clubOwner(id);
        allow create, update: if manager(id) && identifier(rank)
          && request.resource.data.keys().hasAll(['id', 'name', 'displayOrder', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['id', 'name', 'displayOrder', 'createdAt', 'updatedAt'])
          && request.resource.data.id == rank && shortText(request.resource.data.name, 64) && request.resource.data.name.size() > 0
          && request.resource.data.displayOrder is int && request.resource.data.displayOrder >= 0 && request.resource.data.displayOrder <= 999
          && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt == request.time
          && ((!exists(/databases/$(database)/documents/clubs/$(id)/ranks/$(rank)) && request.resource.data.createdAt == request.time)
            || (exists(/databases/$(database)/documents/clubs/$(id)/ranks/$(rank)) && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if manager(id);
      }
      match /wall/info {
        allow read: if member(id) || clubOwner(id);
        allow create, update: if manager(id)
          && request.resource.data.keys().hasAll(['text', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'createdAt', 'updatedAt'])
          && shortText(request.resource.data.text, 4000) && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt == request.time
          && ((!exists(/databases/$(database)/documents/clubs/$(id)/wall/info) && request.resource.data.createdAt == request.time)
            || (exists(/databases/$(database)/documents/clubs/$(id)/wall/info) && request.resource.data.createdAt == resource.data.createdAt));
        allow delete: if manager(id);
      }
    }
    match /users/{uid}/clubRefs/{id} {
      allow read: if owns(uid);
      allow create: if signedIn() && (owns(uid) || manager(id)) && existsAfter(memberPath(id, uid))
        && getAfter(clubPath(id)).data.state in ['active', 'archived']
        && request.resource.data.keys().hasAll(['uid', 'clubId', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'clubId', 'joinedAt'])
        && request.resource.data.uid == uid && request.resource.data.clubId == id && request.resource.data.joinedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (owns(uid) || manager(id))
        && (!existsAfter(memberPath(id, uid)) || getAfter(clubPath(id)).data.state == 'deleted');
    }
    match /clubPages/{id} {
      allow get: if availableClub(id) && resource.data == publicPage(get(clubPath(id)).data)
        && (resource.data.visibility != 'private' || member(id) || clubOwner(id) || invited(id));
      // Discovery uses the smaller /clubDirectory projection; no broad page listing.
      allow list: if false;
      allow create, update: if signedIn() && getAfter(clubPath(id)).data.state in ['active', 'archived']
        && request.resource.data == publicPage(getAfter(clubPath(id)).data)
        && request.resource.data.updatedAt == request.time
        && (getAfter(clubPath(id)).data.ownerUid == request.auth.uid || manager(id)
          || (getAfter(clubPath(id)).data.lastMembershipUid == request.auth.uid
            && ((!exists(memberPath(id, request.auth.uid)) && existsAfter(memberPath(id, request.auth.uid)))
              || (exists(memberPath(id, request.auth.uid)) && !existsAfter(memberPath(id, request.auth.uid))))));
      allow delete: if clubOwner(id) && getAfter(clubPath(id)).data.state == 'deleted';
    }
    match /clubDirectory/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && getAfter(clubPath(id)).data.visibility == 'public' && getAfter(clubPath(id)).data.state == 'active'
        && (getAfter(clubPath(id)).data.ownerUid == request.auth.uid || clubAdmin(id))
        && request.resource.data.keys().hasAll(['id', 'name', 'category', 'membershipPolicy', 'primaryColor', 'accentColor', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'name', 'category', 'membershipPolicy', 'primaryColor', 'accentColor', 'updatedAt'])
        && request.resource.data.id == id && request.resource.data.name == getAfter(clubPath(id)).data.name
        && request.resource.data.category == getAfter(clubPath(id)).data.category
        && request.resource.data.membershipPolicy == getAfter(clubPath(id)).data.membershipPolicy
        && request.resource.data.primaryColor == getAfter(clubPath(id)).data.primaryColor
        && request.resource.data.accentColor == getAfter(clubPath(id)).data.accentColor
        && request.resource.data.updatedAt == request.time;
      allow delete: if clubOwner(id) && (!existsAfter(clubPath(id)) || getAfter(clubPath(id)).data.visibility != 'public'
        || getAfter(clubPath(id)).data.state != 'active');
    }
    // Group identities are immutable UUIDs. Parent documents are never hard-deleted.
    function groupPath(id) { return /databases/$(database)/documents/groupSessions/$(id); }
    function groupMember(id, uid) { return /databases/$(database)/documents/groupSessions/$(id)/participants/$(uid); }
    function groupIndex(id, uid) { return /databases/$(database)/documents/users/$(uid)/groupRefs/$(id); }
    function uuid(value) { return value is string && value.matches('^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$'); }
    function groupAvailable(id) {
      return signedIn() && exists(groupPath(id))
        && (get(groupPath(id)).data.clubId == null || availableClub(get(groupPath(id)).data.clubId));
    }
    function clubHost(id) {
      return member(id) && get(memberPath(id, request.auth.uid)).data.technicalRole in ['owner', 'admin', 'host'];
    }
    function groupManager(id) {
      let g = get(groupPath(id)).data;
      return groupAvailable(id) && ((g.creatorUid == request.auth.uid && (g.clubId == null || clubHost(g.clubId)))
        || (g.clubId != null && manager(g.clubId)));
    }
    function groupParticipant(id) { return groupAvailable(id) && exists(groupMember(id, request.auth.uid)); }
    function groupSummary(g) {
      return {'id': g.id, 'title': g.title, 'description': g.description, 'activityType': g.activityType,
        'category': g.category, 'clubId': g.clubId, 'clubName': g.clubName, 'hostName': g.hostName,
        'startsAt': g.startsAt, 'endsAt': g.endsAt, 'meetingArea': g.meetingArea,
        'visibility': g.visibility, 'joiningPolicy': g.joiningPolicy, 'maxParticipants': g.maxParticipants,
        'state': g.state, 'participantCount': g.participantCount, 'updatedAt': g.updatedAt};
    }
    function validGroup(g, id) {
      return g.keys().hasAll(['id', 'schemaVersion', 'creatorUid', 'clubId', 'clubName', 'hostName', 'title', 'description',
          'activityType', 'category', 'startsAt', 'endsAt', 'meetingArea', 'meetingLocation', 'visibility',
          'joiningPolicy', 'maxParticipants', 'state', 'participantCount', 'lastParticipantUid', 'createdAt', 'updatedAt'])
        && g.keys().hasOnly(['id', 'schemaVersion', 'creatorUid', 'clubId', 'clubName', 'hostName', 'title', 'description',
          'activityType', 'category', 'startsAt', 'endsAt', 'meetingArea', 'meetingLocation', 'visibility',
          'joiningPolicy', 'maxParticipants', 'state', 'participantCount', 'lastParticipantUid', 'createdAt', 'updatedAt'])
        && uuid(id) && g.id == id && g.schemaVersion == 1 && identifier(g.creatorUid) && identifier(g.lastParticipantUid)
        && (g.clubId == null || identifier(g.clubId)) && shortText(g.clubName, 80) && shortText(g.hostName, 64)
        && g.hostName.size() > 0 && shortText(g.title, 80) && g.title.size() > 0 && shortText(g.description, 2000)
        && g.activityType in ['ride', 'drive', 'meet', 'event'] && category(g.category)
        && g.startsAt is int && g.startsAt > 0 && g.startsAt < 4102444800000
        && (g.endsAt == null || (g.endsAt is int && g.endsAt >= g.startsAt && g.endsAt < 4102444800000))
        && shortText(g.meetingArea, 80) && g.meetingArea.size() > 0 && shortText(g.meetingLocation, 500)
        && g.visibility in ['public', 'approval', 'unlisted', 'private'] && g.joiningPolicy in ['open', 'approval', 'invite']
        && (g.visibility != 'approval' || g.joiningPolicy == 'approval') && (g.visibility != 'private' || g.joiningPolicy == 'invite')
        && (g.maxParticipants == null || (g.maxParticipants is int && g.maxParticipants >= 2 && g.maxParticipants <= 50))
        && g.state in ['scheduled', 'active', 'completed', 'cancelled']
        && g.participantCount is int && g.participantCount >= 1 && g.participantCount <= 50
        && (g.maxParticipants == null || g.participantCount <= g.maxParticipants)
        && g.createdAt is timestamp && g.updatedAt == request.time;
    }
    function groupProjection(id, g) {
      return getAfter(/databases/$(database)/documents/groupPages/$(id)).data == groupSummary(g)
        && ((lobbyEligible(g) && getAfter(/databases/$(database)/documents/lobbyEvents/$(id)).data == groupSummary(g))
          || (!lobbyEligible(g) && !existsAfter(/databases/$(database)/documents/lobbyEvents/$(id))));
    }
    function lobbyEligible(g) { return g.visibility in ['public', 'approval'] && g.state in ['scheduled', 'active']; }
    function groupProjectionWriter(id) {
      return signedIn() && (groupBootstrap(id) || groupManager(id)
        || (getAfter(groupPath(id)).data.lastParticipantUid == request.auth.uid
          && (exists(groupMember(id, request.auth.uid)) != existsAfter(groupMember(id, request.auth.uid)))));
    }
    function groupBootstrap(id) {
      let g = getAfter(groupPath(id)).data;
      return !exists(groupPath(id)) && g.creatorUid == request.auth.uid;
    }
    function groupInvite(id, uid) { return /databases/$(database)/documents/groupSessions/$(id)/invites/$(uid); }
    function groupRequest(id, uid) { return /databases/$(database)/documents/groupSessions/$(id)/joinRequests/$(uid); }
    function groupBan(id, uid) { return /databases/$(database)/documents/groupSessions/$(id)/bans/$(uid); }
    function groupInvited(id) {
      return groupAvailable(id) && get(groupPath(id)).data.state in ['scheduled', 'active']
        && exists(groupInvite(id, request.auth.uid)) && get(groupInvite(id, request.auth.uid)).data.expiresAt > request.time;
    }
    function groupAdmission(id, uid) {
      let g = get(groupPath(id)).data;
      return owns(uid) && groupAvailable(id) && g.state in ['scheduled', 'active'] && !exists(groupBan(id, uid))
        && (g.joiningPolicy == 'open'
          || (exists(groupRequest(id, uid)) && get(groupRequest(id, uid)).data.state == 'approved' && g.joiningPolicy == 'approval')
          || (groupInvited(id) && !existsAfter(groupInvite(id, uid))));
    }
    function groupCountChange(id) {
      let uid = request.resource.data.lastParticipantUid;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'lastParticipantUid', 'updatedAt'])
        && ((request.resource.data.participantCount == resource.data.participantCount + 1
            && !exists(groupMember(id, uid)) && existsAfter(groupMember(id, uid)) && groupAdmission(id, uid))
          || (request.resource.data.participantCount == resource.data.participantCount - 1
            && uid != resource.data.creatorUid && exists(groupMember(id, uid)) && !existsAfter(groupMember(id, uid))
            && (owns(uid) || (groupManager(id) && existsAfter(groupBan(id, uid))
              && getAfter(groupBan(id, uid)).data.removedAt == request.time))));
    }
    function groupVehicle(data, uid) {
      return (data.vehicleId == null && data.vehicle == null)
        || (identifier(data.vehicleId) && data.vehicle is map && data.vehicle.keys().hasAll(['nickname', 'category'])
          && data.vehicle.keys().hasOnly(['nickname', 'category'])
          && exists(/databases/$(database)/documents/users/$(uid)/vehicles/$(data.vehicleId))
          && data.vehicle.nickname == get(/databases/$(database)/documents/users/$(uid)/vehicles/$(data.vehicleId)).data.nickname
          && data.vehicle.category == get(/databases/$(database)/documents/users/$(uid)/vehicles/$(data.vehicleId)).data.category);
    }
    function validParticipant(data, uid) {
      return data.keys().hasAll(['uid', 'vehicleId', 'vehicle', 'clubIdentity', 'status', 'joinedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'vehicleId', 'vehicle', 'clubIdentity', 'status', 'joinedAt', 'updatedAt'])
        && data.uid == uid && data.status in ['ok', 'fuel', 'mechanical', 'help']
        && data.joinedAt is timestamp && data.updatedAt == request.time;
    }
    function groupClubIdentity(data, id, uid) {
      let clubId = getAfter(groupPath(id)).data.clubId;
      return data.clubIdentity == null || (clubId != null && availableClub(clubId)
        && exists(memberPath(clubId, uid)) && data.clubIdentity is map
        && data.clubIdentity.keys().hasAll(['name', 'rank']) && data.clubIdentity.keys().hasOnly(['name', 'rank'])
        && data.clubIdentity.name == getAfter(groupPath(id)).data.clubName
        && ((get(memberPath(clubId, uid)).data.rankId == null && data.clubIdentity.rank == null)
          || (get(memberPath(clubId, uid)).data.rankId != null
            && data.clubIdentity.rank == get(/databases/$(database)/documents/clubs/$(clubId)/ranks/$(get(memberPath(clubId, uid)).data.rankId)).data.name)));
    }
    match /groupSessions/{id} {
      allow get: if groupParticipant(id) || groupManager(id);
      allow list: if false;
      allow create: if signedIn() && validGroup(request.resource.data, id) && groupProjection(id, request.resource.data)
        && request.resource.data.creatorUid == request.auth.uid && request.resource.data.lastParticipantUid == request.auth.uid
        && request.resource.data.hostName == get(/databases/$(database)/documents/displayProfiles/$(request.auth.uid)).data.displayName
        && request.resource.data.state == 'scheduled' && request.resource.data.participantCount == 1
        && request.resource.data.createdAt == request.time && existsAfter(groupMember(id, request.auth.uid))
        && existsAfter(groupIndex(id, request.auth.uid))
        && ((request.resource.data.clubId == null && request.resource.data.clubName == '')
          || (clubHost(request.resource.data.clubId) && get(clubPath(request.resource.data.clubId)).data.state == 'active'
            && request.resource.data.clubName == get(clubPath(request.resource.data.clubId)).data.name));
      allow update: if groupAvailable(id) && validGroup(request.resource.data, id) && groupProjection(id, request.resource.data)
        && (groupCountChange(id) || (groupManager(id) && resource.data.state in ['scheduled', 'active']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'activityType', 'category',
          'startsAt', 'endsAt', 'meetingArea', 'meetingLocation', 'visibility', 'joiningPolicy', 'maxParticipants', 'state', 'updatedAt'])
        && ((resource.data.state == 'scheduled' && request.resource.data.state in ['scheduled', 'active', 'cancelled'])
          || (resource.data.state == 'active' && request.resource.data.state in ['active', 'completed', 'cancelled']))));
      allow delete: if false;
      match /participants/{uid} {
        allow get: if groupAvailable(id) && (owns(uid) || groupParticipant(id) || groupManager(id));
        allow list: if (groupParticipant(id) || groupManager(id)) && request.query.limit != null && request.query.limit <= 50;
        allow create: if owns(uid) && validParticipant(request.resource.data, uid) && groupVehicle(request.resource.data, uid)
          && groupClubIdentity(request.resource.data, id, uid)
          && request.resource.data.status == 'ok' && request.resource.data.joinedAt == request.time
          && existsAfter(groupIndex(id, uid))
          && (groupBootstrap(id) || (groupAdmission(id, uid)
            && getAfter(groupPath(id)).data.participantCount == get(groupPath(id)).data.participantCount + 1
            && getAfter(groupPath(id)).data.lastParticipantUid == uid));
        allow update: if owns(uid) && groupAvailable(id) && get(groupPath(id)).data.state in ['scheduled', 'active']
          && validParticipant(request.resource.data, uid) && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vehicleId', 'vehicle', 'clubIdentity', 'status', 'updatedAt'])
          && (request.resource.data.clubIdentity == resource.data.clubIdentity || groupClubIdentity(request.resource.data, id, uid))
          && (request.resource.data.vehicleId == resource.data.vehicleId && request.resource.data.vehicle == resource.data.vehicle
            || groupVehicle(request.resource.data, uid));
        allow delete: if groupAvailable(id) && uid != get(groupPath(id)).data.creatorUid
          && (owns(uid) || groupManager(id)) && !existsAfter(groupIndex(id, uid))
          && getAfter(groupPath(id)).data.participantCount == get(groupPath(id)).data.participantCount - 1
          && getAfter(groupPath(id)).data.lastParticipantUid == uid
          && (owns(uid) || (existsAfter(groupBan(id, uid)) && getAfter(groupBan(id, uid)).data.removedAt == request.time));
      }
      match /joinRequests/{uid} {
        function shape() {
          return request.resource.data.keys().hasAll(['uid', 'state', 'requestedAt', 'decidedAt', 'decidedBy'])
            && request.resource.data.keys().hasOnly(['uid', 'state', 'requestedAt', 'decidedAt', 'decidedBy'])
            && request.resource.data.uid == uid;
        }
        allow get: if groupAvailable(id) && (owns(uid) || groupManager(id));
        allow list: if groupManager(id) && request.query.limit != null && request.query.limit <= 50;
        allow create: if owns(uid) && groupAvailable(id) && get(groupPath(id)).data.state in ['scheduled', 'active']
          && get(groupPath(id)).data.joiningPolicy == 'approval' && !exists(groupMember(id, uid)) && !exists(groupBan(id, uid))
          && shape() && request.resource.data.state == 'pending' && request.resource.data.requestedAt == request.time
          && request.resource.data.decidedAt == null && request.resource.data.decidedBy == null;
        allow update: if groupManager(id) && get(groupPath(id)).data.state in ['scheduled', 'active']
          && shape() && resource.data.state == 'pending' && request.resource.data.requestedAt == resource.data.requestedAt
          && request.resource.data.state in ['approved', 'rejected'] && request.resource.data.decidedAt == request.time
          && request.resource.data.decidedBy == request.auth.uid;
        allow delete: if groupAvailable(id) && (owns(uid) || groupManager(id));
      }
      match /invites/{uid} {
        allow get: if groupAvailable(id) && (owns(uid) || groupManager(id));
        allow list: if groupManager(id) && request.query.limit != null && request.query.limit <= 50;
        allow create, update: if groupManager(id) && get(groupPath(id)).data.state in ['scheduled', 'active']
          && identifier(uid) && !exists(groupBan(id, uid)) && !exists(groupMember(id, uid))
          && request.resource.data.keys().hasAll(['uid', 'token', 'invitedBy', 'createdAt', 'expiresAt'])
          && request.resource.data.keys().hasOnly(['uid', 'token', 'invitedBy', 'createdAt', 'expiresAt'])
          && request.resource.data.uid == uid && uuid(request.resource.data.token) && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.createdAt == request.time && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
        allow delete: if groupAvailable(id) && (owns(uid) || groupManager(id));
      }
      match /bans/{uid} {
        allow get: if groupAvailable(id) && (owns(uid) || groupManager(id));
        allow list: if false;
        allow create: if groupManager(id) && uid != get(groupPath(id)).data.creatorUid
          && exists(groupMember(id, uid)) && !existsAfter(groupMember(id, uid))
          && request.resource.data.keys().hasAll(['uid', 'removedBy', 'removedAt'])
          && request.resource.data.keys().hasOnly(['uid', 'removedBy', 'removedAt'])
          && request.resource.data.uid == uid && request.resource.data.removedBy == request.auth.uid
          && request.resource.data.removedAt == request.time;
        allow update, delete: if false;
      }
    }
    match /users/{uid}/groupRefs/{id} {
      allow read: if owns(uid);
      allow create: if owns(uid) && (groupBootstrap(id) || groupAdmission(id, uid)) && existsAfter(groupMember(id, uid))
        && request.resource.data.keys().hasAll(['uid', 'sessionId', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['uid', 'sessionId', 'joinedAt'])
        && request.resource.data.uid == uid && request.resource.data.sessionId == id && request.resource.data.joinedAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (owns(uid) || groupManager(id)) && !existsAfter(groupMember(id, uid));
    }
    match /groupPages/{id} {
      allow get: if groupAvailable(id) && resource.data == groupSummary(get(groupPath(id)).data)
        && (resource.data.visibility != 'private' || groupParticipant(id) || groupManager(id) || groupInvited(id));
      allow list: if false;
      allow create, update: if groupProjectionWriter(id)
        && request.resource.data == groupSummary(getAfter(groupPath(id)).data) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /lobbyEvents/{id} {
      allow get: if signedIn() && lobbyEligible(resource.data)
        && resource.data == groupSummary(get(groupPath(id)).data) && groupAvailable(id);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 20
        && lobbyEligible(resource.data)
        && resource.data.keys().hasOnly(['id', 'title', 'description', 'activityType', 'category', 'clubId', 'clubName', 'hostName',
          'startsAt', 'endsAt', 'meetingArea', 'visibility', 'joiningPolicy', 'maxParticipants', 'state', 'participantCount', 'updatedAt']);
      allow create, update: if groupProjectionWriter(id) && lobbyEligible(getAfter(groupPath(id)).data)
        && request.resource.data == groupSummary(getAfter(groupPath(id)).data) && request.resource.data.updatedAt == request.time;
      allow delete: if groupProjectionWriter(id) && !lobbyEligible(getAfter(groupPath(id)).data);
    }
    // System admins, live locations, Official activities and every unknown path stay denied.
    match /{document=**} { allow read, write: if false; }
  }
}
