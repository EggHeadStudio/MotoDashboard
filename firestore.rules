rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validProfile(uid) {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'language', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64
        && data.email is string && data.email.size() <= 320
        && data.email == request.auth.token.email
        && data.language in ['en', 'fi']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }
    match /users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid) && validProfile(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if owns(uid) && validProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'email', 'language', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    // Includes nested user collections and every future product collection.
    match /{document=**} { allow read, write: if false; }
  }
}
